{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Phantom",
  "version": "0.1.0",
  "identifier": "com.phantom.desktop",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "windows": [
      {
        "title": "Phantom",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": []
  }
}

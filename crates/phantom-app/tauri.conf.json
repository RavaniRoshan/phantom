{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Phantom",
  "version": "0.1.0",
  "identifier": "com.phantom.desktop",
  "build": {
    "frontendDist": "frontend",
    "beforeDevCommand": {
      "script": "npm run dev -- --host 127.0.0.1",
      "cwd": "../../../frontend-src",
      "wait": false
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../../../frontend-src"
    }
  },
  "app": {
    "windows": [
      {
        "title": "Phantom",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": []
  }
}
